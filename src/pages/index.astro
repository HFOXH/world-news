---
import Layout from '../layouts/Layout.astro';
import Counter from '../components/Counter.vue';
---

<Layout title="World News">
	<main class="mx-auto flex max-w-2xl flex-col items-center gap-8 px-6 py-24">
		<h1 class="text-5xl font-black tracking-tight text-white">World News</h1>
		<p class="text-center text-lg text-zinc-400">
			Proyecto Astro + Vue 3 + TypeScript + Tailwind CSS v4
		</p>
		<Counter client:load />
		<p class="text-sm text-zinc-600">
			Esta isla Vue se hidrata en el cliente; el resto es HTML estático de Astro.
		</p>
	</main>
</Layout>
